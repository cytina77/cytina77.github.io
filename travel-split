<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>旅行分帳工具</title>
<style>
body { font-family: system-ui; background:#f0f2f5; margin:0; }
.container { max-width:800px; margin:auto; padding:16px; }
h2,h3 { margin:0 0 8px }
input, select, button, textarea { width:100%; padding:10px; margin:6px 0; border-radius:8px; border:1px solid #ccc; box-sizing:border-box; }
button { background:#06c755; color:white; border:none; font-size:16px; cursor:pointer; transition:0.2s; }
button:hover { opacity:0.85; }
.event-list { margin:8px 0; display:flex; flex-direction:column; gap:8px; }
.event-item { padding:12px; border-radius:12px; color:white; display:flex; justify-content:space-between; align-items:center; cursor:pointer; transition:0.2s; }
.event-item:hover { opacity:0.85; }
.expense-card { background:#fff; padding:12px; border-radius:12px; margin:6px 0; display:flex; justify-content:space-between; align-items:center; box-shadow:0 2px 6px rgba(0,0,0,0.1); transition:0.2s; }
.expense-card span { flex:1; }
.tag { display:inline-block; padding:2px 6px; border-radius:6px; color:white; font-size:12px; margin-left:4px; }
.tag.餐飲{background:#e74c3c;} .tag.住宿{background:#3498db;} .tag.交通{background:#f39c12;} .tag.飛機{background:#1abc9c;} .tag.玩樂{background:#9b59b6;} .tag.其他{background:#7f8c8d;}
.result { background:#eef; padding:12px; border-radius:8px; margin-top:8px; }
.debt { margin:4px 0 }
.card { background:#fff; padding:16px; border-radius:12px; margin-bottom:16px; box-shadow:0 2px 8px rgba(0,0,0,0.12);}
.row { display:flex; gap:8px; flex-wrap:wrap; }
.row > * { flex:1 }
canvas { background:#fff; border-radius:12px; margin-top:12px; }
</style>
</head>
<body>

<div class="container">
<h2>旅行分帳工具</h2>

<!-- 活動管理 -->
<div class="card">
<h3>活動清單</h3>
<div id="eventList" class="event-list"></div>
<input id="newEventName" placeholder="新增活動名稱">
<label>主要幣別</label>
<select id="eventCurrency">
  <option>AUD</option>
  <option>USD</option>
  <option>JPY</option>
  <option>EUR</option>
</select>
<button onclick="createEvent()">新增活動</button>
</div>

<!-- 活動內容 -->
<div class="card" id="activityCard" style="display:none;">
<h3>活動：<span id="currentEventName"></span></h3>
<button onclick="duplicateEvent()">複製活動</button>

<label> 成員（用逗號分開）</label>
<input id="members" placeholder="例：A,B,C">

<h3>➕ 新增支出</h3>
<input id="expenseTitle" placeholder="項目名稱">
<input id="expenseAmount" type="number" placeholder="金額">
<select id="paidBy"></select>
<input id="split" placeholder="分攤（例：A=100,B=50,C=20）">
<select id="category">
  <option value="餐飲">餐飲</option>
  <option value="住宿">住宿</option>
  <option value="交通">交通</option>
  <option value="飛機">飛機</option>
  <option value="玩樂">玩樂</option>
  <option value="其他">其他</option>
</select>
<label>日期</label>
<input type="date" id="expenseDate">
<label>幣別</label>
<select id="expenseCurrency">
  <option>AUD</option>
  <option>USD</option>
  <option>JPY</option>
  <option>EUR</option>
</select>
<button onclick="addExpense()">加入支出</button>

<h3>🏦 Bank 資訊</h3>
<input id="bankName" placeholder="銀行名稱">
<input id="bsb" placeholder="BSB">
<input id="account" placeholder="Account Number">
<input id="accName" placeholder="Account Name">

<h3>支出列表</h3>
<div id="expenses"></div>

<h3>分帳結果</h3>
<div id="result" class="result"></div>

<h3>每人類別花費圓餅圖</h3>
<label>選擇成員</label>
<select id="selectMember" onchange="renderCategoryChart()"></select>
<canvas id="chartCategory" width="400" height="200"></canvas>

<h3>🔗 分享</h3>
<button onclick="share()">產生專屬連結</button>
<input id="shareLink">
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ---------- 資料 ----------
let events = JSON.parse(localStorage.getItem("events")||"{}");
let currentEvent = null;

// ---------- 活動管理 ----------
function renderEventList(){
  eventList.innerHTML="";
  const colors=["#1abc9c","#3498db","#e67e22","#9b59b6","#e74c3c"];
  let i=0;
  Object.keys(events).forEach(name=>{
    const div = document.createElement("div");
    div.className="event-item";
    div.style.background=colors[i%colors.length];
    i++;
    div.innerHTML=`<span>${name}</span>
    <div>
      <button onclick="deleteEvent('${name}')">刪除</button>
      <button onclick="loadEvent('${name}')">載入</button>
    </div>`;
    eventList.appendChild(div);
  });
}

function createEvent(){
  const name = newEventName.value.trim();
  const currency = eventCurrency.value;
  if(!name) return alert("請輸入活動名稱");
  if(events[name]) return alert("活動已存在");
  events[name]={members:[],expenses:[],bank:{},currency:currency};
  saveEvents(); renderEventList(); newEventName.value="";
}

function deleteEvent(name){ delete events[name]; saveEvents(); renderEventList(); if(currentEvent===name){activityCard.style.display="none"; currentEvent=null;} }

function loadEvent(name){
  currentEvent = name;
  currentEventName.innerText=name;
  activityCard.style.display="block";
  const e = events[name];
  members.value = e.members.join(",");
  bankName.value=e.bank.bankName||"";
  bsb.value=e.bank.bsb||"";
  account.value=e.bank.account||"";
  accName.value=e.bank.accName||"";
  eventCurrency.value = e.currency || "AUD";
  paidBy.innerHTML = e.members.map(m=>`<option>${m}</option>`).join("");
  renderExpenses(); renderResult(); renderCategoryChart();
}

// ---------- 複製活動 ----------
function duplicateEvent(){
  if(!currentEvent) return;
  let newName = prompt("輸入新活動名稱");
  if(!newName) return;
  if(events[newName]) return alert("活動已存在");
  events[newName]=JSON.parse(JSON.stringify(events[currentEvent]));
  saveEvents(); renderEventList();
}

// ---------- 成員管理 ----------
members.onchange=()=>{
  if(!currentEvent) return;
  const e = events[currentEvent];
  e.members=members.value.split(",").map(v=>v.trim()).filter(v=>v);
  paidBy.innerHTML = e.members.map(m=>`<option>${m}</option>`).join("");
  saveEvents(); renderExpenses(); renderResult(); renderCategoryChart();
}

// ---------- 支出管理 ----------
function addExpense(){
  if(!currentEvent) return;
  const e = events[currentEvent];
  const splitObj={};
  split.value.split(",").forEach(p=>{
    let [k,v]=p.split("=");
    if(k&&v) splitObj[k.trim()]=Number(v);
  });
  e.expenses.push({
    title:expenseTitle.value,
    amount:Number(expenseAmount.value),
    paidBy:paidBy.value,
    split:splitObj,
    category:category.value,
    date:expenseDate.value || "",
    currency:expenseCurrency.value
  });
  saveEvents(); renderExpenses(); renderResult(); renderCategoryChart();
  expenseTitle.value=""; expenseAmount.value=""; split.value=""; expenseDate.value=""; expenseCurrency.value=eventCurrency.value;
}

// ---------- 顯示支出 ----------
function renderExpenses(){
  if(!currentEvent) return;
  const e = events[currentEvent];
  e.expenses.sort((a,b)=>new Date(a.date)-new Date(b.date));
  expenses.innerHTML="";
  e.expenses.forEach((x,i)=>{
    const div=document.createElement("div");
    div.className="expense-card";
    div.innerHTML=`<span>${x.date} ${x.title} $${x.amount} (${x.currency}, ${x.paidBy} 付)<span class="tag ${x.category}">${x.category}</span></span>
    <div>
      <button onclick="editExpense(${i})">編輯</button>
      <button onclick="deleteExpense(${i})">刪除</button>
    </div>`;
    expenses.appendChild(div);
  });
}

function editExpense(i){
  const e = events[currentEvent];
  const ex=e.expenses[i];
  const title = prompt("項目名稱",ex.title);
  if(title===null) return;
  const amount = prompt("金額",ex.amount);
  if(amount===null) return;
  const paid = prompt("付款人",ex.paidBy);
  if(paid===null) return;
  const splitStr = prompt("分攤（A=50,B=30）",Object.entries(ex.split).map(([k,v])=>k+"="+v).join(","));
  if(splitStr===null) return;
  const cat = prompt("類別（餐飲/住宿/交通/飛機/玩樂/其他）",ex.category);
  if(cat===null) return;
  const date = prompt("日期",ex.date);
  if(date===null) return;
  const currency = prompt("幣別",ex.currency);
  if(currency===null) return;
  const splitObj={};
  splitStr.split(",").forEach(p=>{
    let [k,v]=p.split("=");
    if(k&&v) splitObj[k.trim()]=Number(v);
  });
  e.expenses[i]={title:title,amount:Number(amount),paidBy:paid,split:splitObj,category:cat,date:date,currency:currency};
  saveEvents(); renderExpenses(); renderResult(); renderCategoryChart();
}

function deleteExpense(i){
  const e = events[currentEvent];
  e.expenses.splice(i,1);
  saveEvents(); renderExpenses(); renderResult(); renderCategoryChart();
}

// ---------- 計算分帳 ----------
function renderResult(){
  if(!currentEvent) return;
  const e = events[currentEvent];
  const bal={}; e.members.forEach(m=>bal[m]=0);
  e.expenses.forEach(ex=>{
    Object.entries(ex.split).forEach(([m,v])=>bal[m]-=v);
    bal[ex.paidBy]+=ex.amount;
  });
  const debtors=[], creditors=[];
  Object.entries(bal).forEach(([m,v])=>{
    if(v<0) debtors.push([m,-v]);
    if(v>0) creditors.push([m,v]);
  });
  let res=[];
  debtors.forEach(d=>{
    creditors.forEach(c=>{
      const pay=Math.min(d[1],c[1]);
      if(pay>0){ res.push(`${d[0]} ➜ ${c[0]}：$${pay.toFixed(2)}`); d[1]-=pay; c[1]-=pay; }
    });
  });
  const bankInfo = e.bank;
  let bankText="";
  if(bankInfo.bankName) bankText=`🏦 Bank：${bankInfo.bankName} / BSB:${bankInfo.bsb} / Acc:${bankInfo.account} / Name:${bankInfo.accName}<br>`;
  result.innerHTML=bankText + res.map(r=>`<div class="debt">${r}</div>`).join("");
}

// ---------- 每人類別圓餅圖 ----------
let categoryChartInstance=null;
function renderCategoryChart(){
  if(!currentEvent) return;
  const e = events[currentEvent];
  const categories=["餐飲","住宿","交通","飛機","玩樂","其他"];
  const memberSelect = document.getElementById('selectMember');
  memberSelect.innerHTML = e.members.map(m=>`<option>${m}</option>`).join("");
  const selectedMember = memberSelect.value || e.members[0];

  const data = categories.map(cat=>{
    return e.expenses.filter(ex=>ex.paidBy===selectedMember && ex.category===cat).reduce((sum,ex)=>sum+ex.amount,0);
  });

  const colors=["#e74c3c","#3498db","#f39c12","#1abc9c","#9b59b6","#7f8c8d"];
  const ctx = document.getElementById('chartCategory').getContext('2d');
  if(categoryChartInstance) categoryChartInstance.destroy();
  categoryChartInstance = new Chart(ctx,{
    type:'pie',
    data:{
      labels:categories,
      datasets:[{data:data,backgroundColor:colors}]
    },
    options:{responsive:true}
  });
}

// ---------- Bank 訊息 ----------
[bankName,bsb,account,accName,eventCurrency].forEach(x=>x.addEventListener("change",()=>{
  if(!currentEvent) return;
  const e = events[currentEvent];
  e.bank = { bankName:bankName.value, bsb:bsb.value, account:account.value, accName:accName.value };
  e.currency = eventCurrency.value;
  saveEvents(); renderResult(); renderCategoryChart();
}));

// ---------- 專屬連結 ----------
function share(){
  if(!currentEvent) return;
  const e = events[currentEvent];
  const link = location.origin + location.pathname + "?event=" + encodeURIComponent(currentEvent) + "&data=" + btoa(JSON.stringify(e));
  shareLink.value=link;
}

// ---------- 載入專屬連結 ----------
if(location.search){
  const p = new URLSearchParams(location.search);
  const name = p.get("event");
  const d = p.get("data");
  if(name && d){
    events[name]=JSON.parse(atob(d));
    saveEvents();
    loadEvent(name);
  }
}

// ---------- 儲存 ----------
function saveEvents(){ localStorage.setItem("events", JSON.stringify(events)); renderEventList(); }

renderEventList();
</script>

</body>
</html>
